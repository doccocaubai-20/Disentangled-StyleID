# Copy this file to .env in the root StyleID_Core folder (beside mo_server.bat).
# Existing system environment variables take priority.
# Keep settings commented to use automatic path detection.
# For custom paths, uncomment and use absolute paths with forward slashes.

# Folder containing data/ and SKSF-A_data/ (optional for custom uploads).
# STYLEID_RESOURCES=C:/StyleID_Core

# Folder containing BOTH exact Soup checkpoint files:
# disentangled_lora_clip_SOUP_S6_A100.pt
# disentangled_head_SOUP_S6_A100.pt
# STYLEID_CHECKPOINT_DIR=C:/StyleID_Core/checkpoints/soup

# Optional LFW dataset location, used by test_lfw_full_6000.py.
# STYLEID_LFW_HOME=C:/datasets/lfw_home

# Optional Hugging Face model download cache.
# HF_HOME=C:/model_cache/huggingface
