# Copy this file to 04_demo/.env (beside server.py).
# Existing system environment variables take priority.
# Keep settings commented to use the default cache and Drive IDs.
# For custom paths, uncomment and use absolute paths with forward slashes.

# Local directory for both Soup checkpoints:
# disentangled_lora_clip_SOUP_S6_A100.pt
# disentangled_head_SOUP_S6_A100.pt
# STYLEID_CHECKPOINT_DIR=C:/StyleID_Core/checkpoints/soup

# Optional local copy of the LFW-only adapter or an alternate Drive file ID.
# STYLEID_HP_ADAPTER_PATH=C:/StyleID_Core/checkpoints/hard-positive-adapter/lfw_hard_positive_adapter.pt
# STYLEID_HP_ADAPTER_DRIVE_ID=12saHW4q3RPIVwel2uJpsnsgv_YJDZLA8

# Optional local archive matching the benchmark's LFW funneled data.
# STYLEID_LFW_ARCHIVE=C:/datasets/lfw-funneled.tgz

# Optional Hugging Face model download cache.
# HF_HOME=C:/model_cache/huggingface
